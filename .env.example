# Azure AI Foundry / Azure OpenAI
#
# VIKTIG: Bruk kun base-URL fra "Keys and Endpoint" i Azure-portalen.
# Ikke lim inn full API-sti som /openai/v1/responses eller /chat/completions.
#
# Riktig:
#   https://<resource>.openai.azure.com
#   https://<resource>.services.ai.azure.com
#
# Feil:
#   https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_FOUNDRY_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=your-api-key
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o

# Valgfritt. v1 (standard) trenger ikke api-version. legacy krever f.eks. 2024-10-21.
# AZURE_FOUNDRY_API_MODE=v1
# AZURE_FOUNDRY_API_VERSION=2024-10-21
